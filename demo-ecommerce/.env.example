# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Google Merchant Center (Merchant API)
GOOGLE_MERCHANT_ID=
GOOGLE_MERCHANT_DATA_SOURCE_ID=
# Source « Avis produits » (programme Évaluations de produits). Vide = envoi des avis désactivé.
GOOGLE_MERCHANT_REVIEWS_DATA_SOURCE_ID=
# Local: path to the service account JSON key. Prod/Vercel: prefer GOOGLE_SERVICE_ACCOUNT_KEY with the JSON content.
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
GOOGLE_SERVICE_ACCOUNT_KEY=

# Meta Pixel (optional, leave empty to disable)
NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console verification token (optional)
GOOGLE_SITE_VERIFICATION=

# Demo seed (npm run seed:demo) — admin account created on first seed
SEED_ADMIN_EMAIL=admin@sable-store.test
SEED_ADMIN_PASSWORD=change-me
